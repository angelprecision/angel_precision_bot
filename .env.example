BOT_DB_FILE=ap_state.db
BOT_MODE=SIM           # SIM | PAPER | LIVE | READ_ONLY
LOG_LEVEL=INFO

# Core rules
MAX_TRADES_PER_DAY=4
MAX_CONCURRENT_POSITIONS=2
BASE_POSITION_PCT=0.15

TAKE_PROFIT_PCT=0.30   # 0.25 - 0.30
STOP_LOSS_PCT=0.50     # 0.40 - 0.50

DAILY_MAX_LOSS_PCT=0.06

# Growth throttles
GROWTH_THROTTLE_50=0.50   # >= 50% growth => reduce size
GROWTH_THROTTLE_75=0.75   # >= 75% growth => reduce trades/day to 2
GROWTH_THROTTLE_90=0.90   # >= 90% growth => hard stop entries

REDUCED_POSITION_PCT_50=0.12
REDUCED_MAX_TRADES_75=2

# Drawdown gates (run-level)
DRAWDOWN_STOP_DAY=0.12
DRAWDOWN_KILL=0.20

# Entry window defaults (ET)
ENTRY_START_ET=09:35
ENTRY_END_ET=13:30
NO_ENTRY_LAST_MINUTES=10
COOLDOWN_AFTER_EXIT_MINUTES=3

# Quote/data safety
MAX_SPREAD_PCT=0.10
MAX_QUOTE_AGE_SECONDS=5


# ─────────────────────────────────────────────────────────────────────────
# Live Authorization Gate (client consent for NEW live entries)
# ─────────────────────────────────────────────────────────────────────────
# Controls whether the gate ENFORCES (rejects unauthorized/unknown-mode new
# live entries) or only OBSERVES (logs LIVE_AUTHORIZATION_WOULD_BLOCK and
# allows the entry). DEFAULT IS OBSERVE-ONLY (false) for staged rollout.
#
#   ROLLOUT: deploy with false, watch LIVE_AUTHORIZATION_WOULD_BLOCK in logs,
#            then flip to true once the gate is trusted.
#   PRODUCTION LIVE CLIENT LAUNCH: Render MUST set this to true. The gate is
#            NOT enforced until you do. Known paper/sandbox clients are exempt
#            in both modes; exits/stops/reconcile/EOD-flatten are NEVER gated.
LIVE_AUTHORIZATION_GATE_ENFORCE=false

# Must match the dashboard backend's disclosure.py DISCLOSURE_VERSION so the
# bot and dashboard agree on which live authorizations are valid.
DISCLOSURE_VERSION=2026.06.1
