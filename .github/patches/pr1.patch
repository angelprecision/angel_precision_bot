diff --git a/tests/test_p0_terminal_disposition_truth.py b/tests/test_p0_terminal_disposition_truth.py
new file mode 100644
index 0000000000000000000000000000000000000000..08e09c92d0264013c45014ab685419474211ad53
--- /dev/null
+++ b/tests/test_p0_terminal_disposition_truth.py
@@ -0,0 +1,61 @@
+"""PR #401 follow-up: terminal disposition must reflect durable write truth.
+
+The existing end-to-end deferred-lifecycle suite exercises the runtime terminal
+write path.  This focused contract test prevents the five audited call sites in
+``APExecutionCore._on_entry_trigger`` from discarding that runtime result and
+fabricating ``TERMINAL_DURABLE`` after a failed terminal CAS.
+"""
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "ap_execution_core.py"
+MARKERS = {
+    "attempt_counter_conflict": "_attempt_conflict_reason",
+    "cursor_load_failure": "_cursor_failure_reason",
+    "terminal_market_truth": "_terminal_market_reason",
+    "retry_exhaustion": "BREACH_RETRY_EXHAUSTED",
+    "invalid_selector_result": "selector_result_validation",
+}
+
+
+def _on_entry_trigger_node() -> ast.FunctionDef:
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    for node in tree.body:
+        if isinstance(node, ast.ClassDef) and node.name == "APExecutionCore":
+            for item in node.body:
+                if isinstance(item, ast.FunctionDef) and item.name == "_on_entry_trigger":
+                    return item
+    raise AssertionError("APExecutionCore._on_entry_trigger not found")
+
+
+def _is_terminalizer_call(node: ast.AST) -> bool:
+    return (
+        isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id == "_terminalize_deferred_breach_failure"
+    )
+
+
+def test_audited_terminal_branches_return_the_terminalizer_result_directly():
+    method = _on_entry_trigger_node()
+    source = SOURCE.read_text(encoding="utf-8")
+
+    direct_returns: list[str] = []
+    discarded_calls: list[str] = []
+    for node in ast.walk(method):
+        if isinstance(node, ast.Return) and _is_terminalizer_call(node.value):
+            direct_returns.append(ast.get_source_segment(source, node) or "")
+        elif isinstance(node, ast.Expr) and _is_terminalizer_call(node.value):
+            discarded_calls.append(ast.get_source_segment(source, node) or "")
+
+    for label, marker in MARKERS.items():
+        assert any(marker in segment for segment in direct_returns), (
+            f"{label} must return _terminalize_deferred_breach_failure(...) "
+            "so KEEP_WATCHER survives a failed durable terminal write"
+        )
+        assert not any(marker in segment for segment in discarded_calls), (
+            f"{label} still discards the terminalizer result"
+        )
